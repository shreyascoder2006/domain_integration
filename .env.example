# Copy to .env and fill in. The app reads the environment only (it does not load .env itself):
#   node --env-file=.env server.js     (Node 22)    or   docker run --env-file .env ...
# Comments are on their own lines on purpose: Docker's env-file parser keeps inline comments as part of the value.
# NEVER commit a real .env (it is in .gitignore).

# ---- Server ----
PORT=3000
NODE_ENV=production
# Where orders and mailboxes are stored (a JSON file; mount a persistent volume here).
DATA_FILE=./data/db.json
# Set to 1 behind a reverse proxy / load balancer so rate limits see the real client address.
TRUST_PROXY=1
# Required in production: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
# Enables /admin.html and the admin API. 24+ characters in production.
ADMIN_TOKEN=

# ---- Which adapters to use. Production refuses "mock" unless ALLOW_MOCKS=1 (demo only) ----
# REGISTRAR: mock | namesilo
REGISTRAR=namesilo
# DNS_PROVIDER: mock | cloudflare (not used when the mailbox vendor runs DNS)
DNS_PROVIDER=cloudflare
# MAILBOX_VENDOR: mock | zapmail
MAILBOX_VENDOR=zapmail
# PAYMENTS: mock | razorpay
PAYMENTS=razorpay

# ---- NameSilo ----
NAMESILO_API_KEY=
# Their sandbox base URL, if they issue you one:
# NAMESILO_BASE_URL=
# 0 = we renew when the customer pays; 1 = the registrar auto-renews from account balance
# NAMESILO_AUTO_RENEW=0

# ---- Cloudflare (token needs Zone:Edit, DNS:Edit, Single Redirect:Edit) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- Zapmail ----
ZAPMAIL_API_KEY=
ZAPMAIL_WORKSPACE_KEY=
# From POST /v2/webhooks/endpoints. Speeds up provisioning; polling still works without it.
ZAPMAIL_WEBHOOK_SECRET=
# Comma list. Confirm with Zapmail: their docs show four different sets.
# ZAPMAIL_NAMESERVERS=

# ---- Razorpay (use TEST keys first) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A separate secret you choose when creating the webhook in the Dashboard.
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_MERCHANT_NAME=CloudLead

# ---- Billing rules ----
# subscription (default) or one_time
# BILLING_MODE=subscription
# Days of service after every charge retry has failed
# BILLING_GRACE_DAYS=7
# Days suspended mailboxes are kept before the vendor is asked to remove them
# BILLING_RETENTION_DAYS=14

# ---- Timers and limits ----
# Pipeline + billing timer; 0 disables
# POLL_INTERVAL_MS=15000
# Give up on a pending step after 48 hours
# WAIT_TIMEOUT_MS=172800000
# Back-off for quick retries
# RETRY_BASE_MS=1000
# Disable per-IP rate limits (tests only)
# RATE_LIMIT=off

# ---- Storage ----
# json (default) or sqlite. SQLite writes one row per record instead of rewriting a file; one server process only either way.
# STORE=sqlite
# SQLITE_FILE=./data/db.sqlite

# ---- Public address (used in emails, alerts and the preflight check; https in production) ----
PUBLIC_URL=https://app.example.com

# ---- Customer emails ----
# mock (default; nothing leaves the machine) or resend
NOTIFY_PROVIDER=resend
RESEND_API_KEY=
# A sender address on a domain you have verified with the email provider
NOTIFY_FROM=CloudLead <no-reply@example.com>

# ---- Ops alerts (all optional; alerts are always written to the log) ----
# ALERT_SLACK_WEBHOOK=
# ALERT_EMAIL=ops@example.com
# Alert when the mailbox vendor has fewer free slots than this, or less wallet money (USD)
# ALERT_MIN_SLOTS=10
# ALERT_MIN_WALLET=20

# ---- Sending engine and monitoring ----
# Enables /api/engine/* for the sending/warm-up engine. 24+ characters in production.
# ENGINE_TOKEN=
# Bearer token for GET /metrics (falls back to ADMIN_TOKEN)
# METRICS_TOKEN=

# ---- Receipts (printed on each receipt; ask your accountant what the wording must be) ----
# INVOICE_TITLE=Receipt
# INVOICE_SELLER_NAME=
# INVOICE_SELLER_ADDRESS=
# INVOICE_TAX_LABEL=GSTIN
# INVOICE_TAX_ID=
# INVOICE_TAX_NOTE=
# Shown beside the terms checkbox when set (https URLs only)
# TERMS_URL=
# PRIVACY_URL=
# REFUND_URL=

# ---- Abuse and spend protection ----
# Maximum domains registered per rolling 24 hours across all customers (protects your registrar balance)
# DAILY_DOMAIN_CAP=200
# MAX_DOMAINS_PER_ORDER=20
# Comma lists: extend the built-in disposable-email and brand-abuse lists, or allow a specific domain
# ABUSE_DISPOSABLE_DOMAINS=
# ABUSE_BLOCK_TERMS=
# ABUSE_ALLOW_DOMAINS=

# ---- Logging ----
# debug | info | warn | error
# LOG_LEVEL=info
# json (default in production) or text
# LOG_FORMAT=json

# ---- Demo / testing only (never honoured in production) ----
# DEV_TOOLS=1
# MOCK_WEBHOOK_SECRET=
# Give up on domain verification after this long (the mailbox vendor refuses domains older than 24 hours)
# WAIT_TIMEOUT_CONNECT_MS=72000000
